# PostgreSQL development database
POSTGRES_DB=ei_db
POSTGRES_USER=ei_dungeon
POSTGRES_PASSWORD=change-this-development-password
POSTGRES_PORT=5432

# ASP.NET Core backend
BACKEND_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
CORS_ALLOWED_ORIGINS=http://localhost:8000

# Application secrets - replace these values in .env
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key

SPARKS_CAPACITY=820
SPARKS_INITIAL_AMOUNT=15
SPARKS_REFILL_AMOUNT=15
SPARKS_ESTIMATED_UNIT_COST=0.0061
SPARKS_CLOSING_DAY=10
SPARKS_RENEWAL_LEAD_DAYS=3
SPARKS_QUEUE_INTERVAL_MINUTES=60
SPARKS_OPENROUTER_MANAGEMENT_KEY=
SPARKS_ADMINISTRATIVE_RECIPIENTS=
JWT_SECRET=development-only-jwt-secret-change-me-before-use-0123456789-abcdef

# Email verification / recovery (configure before using account flows)
# From must belong to a sender/domain allowed by your Resend account.
RESEND_API_TOKEN=
RESEND_FROM=
# Independent secret used to protect verification codes, not the Resend API token.
VERIFICATION_CODE_HASH_KEY=

# Public Google web client ID matching the frontend build. Empty disables Google.
GOOGLE_CLIENT_ID=
