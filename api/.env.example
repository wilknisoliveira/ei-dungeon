# PostgreSQL development database
POSTGRES_DB=ei_db
POSTGRES_USER=ei_dungeon
POSTGRES_PASSWORD=change-this-development-password
POSTGRES_PORT=5432

# ASP.NET Core backend
BACKEND_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
CORS_ALLOWED_ORIGINS=http://localhost:8000

# Application secrets - replace these values in .env
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
JWT_SECRET=development-only-jwt-secret-change-me-before-use-0123456789-abcdef

# Email verification / recovery (configure before using account flows)
# From must belong to a sender/domain allowed by your Resend account.
RESEND_API_TOKEN=
RESEND_FROM=
# Independent secret used to protect verification codes, not the Resend API token.
VERIFICATION_CODE_HASH_KEY=
